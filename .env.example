# Copy to .env and fill in. .env is gitignored; in the cloud, source these from a secrets manager / KMS instead.
# Coinbase market data is public: no API key needed.

# --- Kafka ---
KAFKA_HOST_PORT=9092                 # host port for apps outside Docker
KAFKA_TOPIC=raw.trades

# --- Object storage (MinIO locally, S3 in the cloud) ---
LAKE_BUCKET=crypto-lake
S3_ENDPOINT=http://minio:9000        # leave empty to use real AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>          # locally this is also the MinIO root user
AWS_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>  # locally also the MinIO root password (min 8 chars)
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- ML ---
MLFLOW_TRACKING_URI=file:./mlruns
