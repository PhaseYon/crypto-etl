# Copy to .env and fill in. .env is gitignored; in the cloud, source these from a secrets manager / KMS instead.
# Coinbase market data is public: no API key needed.

# --- Kafka ---
KAFKA_HOST_PORT=9092                 # host port for apps outside Docker
KAFKA_TOPIC=raw.trades

# --- Producer ---
PRODUCTS=BTC-USD,ETH-USD,SOL-USD
PRODUCER_LOG_LEVEL=INFO
MAX_BACKFILL_TRADES=500000              # larger gaps are logged, not backfilled

# --- Object storage (S3-compatible store locally: RustFS behind the `minio` service; S3 in the cloud) ---
LAKE_BUCKET=crypto-lake
S3_ENDPOINT=http://minio:9000        # leave empty to use real AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>          # locally also the object store's root user
AWS_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>  # locally also its root password (min 8 chars)
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- ML ---
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db   # MLflow 3.x rejects the plain file store
MLFLOW_ARTIFACT_ROOT=mlruns/artifacts          # or s3://<bucket>/mlflow

# --- Dashboard ---
DASHBOARD_HOST_PORT=3000
DASHBOARD_API_HOST_PORT=8000
DASHBOARD_DATA_SOURCE=real              # or `mock` for fixture data
