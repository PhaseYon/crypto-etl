{
  "openapi": "3.1.0",
  "info": {
    "title": "crypto-etl dashboard API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/livez": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Livez",
        "description": "Liveness only: the API process is up. Source health is reported by /api/pipeline.",
        "operationId": "livez_api_livez_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Meta",
        "operationId": "meta_api_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Pipeline",
        "operationId": "pipeline_api_pipeline_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/market/ohlcv": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Ohlcv",
        "operationId": "ohlcv_api_market_ohlcv_get",
        "parameters": [
          {
            "name": "product",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Product id, e.g. BTC-USD",
              "title": "Product"
            },
            "description": "Product id, e.g. BTC-USD"
          },
          {
            "name": "minutes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 10080,
              "minimum": 15,
              "description": "Look-back window",
              "default": 360,
              "title": "Minutes"
            },
            "description": "Look-back window"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MarketResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/quality": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Quality",
        "operationId": "quality_api_quality_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ml/predictions": {
      "get": {
        "tags": [
          "dashboard"
        ],
        "summary": "Predictions",
        "operationId": "predictions_api_ml_predictions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
